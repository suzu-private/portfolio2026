mixin work-card(option, index)
  - 
    const {
      title = '',
      schedule = '',
      member = '',
      tabs = [],
      summary = '',
      skills = [],
      roles = [],
      description = ''
    } = option

  .c-work-card(data-sort-works="card")
    .c-work-card__header 
      .c-work-card__header-title 
        span #{ index }
        p #{ title }
      .c-work-card__header-detail 
        p
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar">
            <path d="M8 2v4"></path>
            <path d="M16 2v4"></path>
            <rect width="18" height="18" x="3" y="4" rx="2"></rect>
            <path d="M3 10h18"></path>
          </svg>
          != schedule
        p
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          | #{ member }名
    .c-work-card__content
      .c-work-card__content-tab
        each tab in tabs
          .detail-tab(data-sort-works="tab") ##{tab}
      .c-work-card__content-main 
        .content-item
          .content-item__title 概要
          .content-item__description!= summary
        .content-item 
          .content-item__title 使用技術
          .content-item__description 
            each skill in skills 
              .skill-tab= skill 
        .content-item 
          .content-item__title 担当内容
          .content-item__description 
            each role in roles 
              .roll-item!= role
        .content-item 
          .content-item__title 取り組み
          .content-item__description!= description 


          
