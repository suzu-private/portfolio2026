mixin menu-card(options)
  each option in options
    - 
      const {
        title = '',
        subTitle = '',
        icon = '',
        href = ''
      } = option

    a.c-menu-card(href=`${href}` data-animation-card="item")
      .c-menu-card__icon
        img(src=`./assets/img/icon/${icon}`)
      .c-menu-card__icon.c-menu-card__icon--bottom
        img(src=`./assets/img/icon/${icon}`)
      .c-menu-card__title
        p #{title}
          span #{subTitle}
