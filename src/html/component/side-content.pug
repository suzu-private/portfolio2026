mixin side-content(text, options)
  .c-side-content.check-background.js-menu
    .c-side-content__close.sp-only(data-js-menu="close-btn")
      button.c-side-content__close-btn(type="button")
        span close
    .c-side-content__top
      .c-side-nav
        ul.c-side-nav__link-wrap
          li.c-side-nav__link-item
            a.c-side-nav__link(href="./index.html") TOP
            - const menuItems = require('../data/top-menu.json');
            each item in menuItems
              li.c-side-nav__link-item
                a.c-side-nav__link(href=item.href, class={ 'is-active': item.titleEn === text }) 
                  | #{ item.title }
      ul.c-side-info
        li.c-side-info__item
          a(href="mailto:suzu_official@outlook.jp")
            img(src="../assets/img/icon/mail.svg" alt="")
            span suzu_official@outlook.jp
    p.c-side-text #{ text }

mixin nav-header-sp
  .c-nav-content.sp-only
    .c-nav-content__inner
      .c-nav-content__name
        h1
          a(href="./index.html") Kashiwagi Suzu
      .c-nav-content__open(data-js-menu="open-btn")
        button.c-nav-content__open-btn(type="button")
          span Menu
