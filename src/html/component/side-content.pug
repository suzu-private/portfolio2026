mixin side-content(text, options)
  .c-side-content.check-background
    .c-side-content__top
      .c-side-nav
        ul.c-side-nav__link-wrap
          li.c-side-nav__link-item
            a.c-side-nav__link(href="./index.html") TOP
            - const menuItems = require('../data/top-menu.json');
            each item in menuItems
              li.c-side-nav__link-item
                a.c-side-nav__link(href=item.href, class={ 'is-active': item.titleEn === text }) 
                  | #{ item.title }
      ul.c-side-info
        li.c-side-info__item
          a(href="mailto:suzu_official@outlook.jp")
            img(src="../assets/img/icon/mail.svg")
            span suzu_official@outlook.jp
    p.c-side-text #{ text }