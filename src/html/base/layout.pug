include ../component/index.pug

doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="format-detection" content="telephone=no")
    
    block titleVariable
    title #{ pageTitle } | Kashiwagi Suzu
